test compile precise-output
set unwind_info=false
target aarch64

;; An instruction with a 32-bit destination writes a W register, which zeroes
;; bits 63:32 of the underlying X register, so a `uextend` of its result needs
;; no instruction of its own. `zeroes_upper32` in `lower.isle` is the whitelist
;; of opcodes claimed to have that property; these tests are how the claim is
;; checked, so read each block's disassembly and confirm the producer really is
;; the W form before adding an opcode to it.

function %uext_iadd(i32, i32) -> i64 {
block0(v0: i32, v1: i32):
  v2 = iadd v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   add w0, w0, w1
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   add w0, w0, w1
;   ret

function %uext_isub(i32, i32) -> i64 {
block0(v0: i32, v1: i32):
  v2 = isub v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   sub w0, w0, w1
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   sub w0, w0, w1
;   ret

function %uext_imul(i32, i32) -> i64 {
block0(v0: i32, v1: i32):
  v2 = imul v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   madd w0, w0, w1, wzr
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   mul w0, w0, w1
;   ret

function %uext_udiv(i32, i32) -> i64 {
block0(v0: i32, v1: i32):
  v2 = udiv v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   cbz w1, #trap=int_divz
;   udiv w0, w0, w1
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   cbz w1, #0xc
;   udiv w0, w0, w1
;   ret
;   udf #0xc11f ; trap: int_divz

function %uext_sdiv(i32, i32) -> i64 {
block0(v0: i32, v1: i32):
  v2 = sdiv v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   cbz w1, #trap=int_divz
;   adds wzr, w1, #1
;   ccmp w0, #1, #nzcv, eq
;   b.vs #trap=int_ovf
;   sdiv w0, w0, w1
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   cbz w1, #0x18
;   cmn w1, #1
;   ccmp w0, #1, #0, eq
;   b.vs #0x1c
;   sdiv w0, w0, w1
;   ret
;   udf #0xc11f ; trap: int_divz
;   udf #0xc11f ; trap: int_ovf

function %uext_urem(i32, i32) -> i64 {
block0(v0: i32, v1: i32):
  v2 = urem v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   cbz w1, #trap=int_divz
;   udiv w4, w0, w1
;   msub w0, w4, w1, w0
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   cbz w1, #0x10
;   udiv w4, w0, w1
;   msub w0, w4, w1, w0
;   ret
;   udf #0xc11f ; trap: int_divz

function %uext_srem(i32, i32) -> i64 {
block0(v0: i32, v1: i32):
  v2 = srem v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   cbz w1, #trap=int_divz
;   sdiv w4, w0, w1
;   msub w0, w4, w1, w0
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   cbz w1, #0x10
;   sdiv w4, w0, w1
;   msub w0, w4, w1, w0
;   ret
;   udf #0xc11f ; trap: int_divz

