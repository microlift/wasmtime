function %uext_sextend_to_i32(i16) -> i64 {
block0(v0: i16):
  v1 = sextend.i32 v0
  v2 = uextend.i64 v1
  return v2
}

; VCode:
; block0:
;   sxth w0, w0
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   sxth w0, w0
;   ret

function %uext_uextend_to_i32(i16) -> i64 {
block0(v0: i16):
  v1 = uextend.i32 v0
  v2 = uextend.i64 v1
  return v2
}

; VCode:
; block0:
;   uxth w0, w0
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   uxth w0, w0
;   ret

function %uext_ishl_imm(i32) -> i64 {
block0(v0: i32):
  v1 = iconst.i32 3
  v2 = ishl v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   lsl w0, w0, #3
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   lsl w0, w0, #3
;   ret

function %uext_iadd_imm(i32) -> i64 {
block0(v0: i32):
  v1 = iconst.i32 7
  v2 = iadd v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   add w0, w0, #7
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   add w0, w0, #7
;   ret

;; The extended value having another use must not change the answer: the
;; zeroing is a property of the producing instruction, not of this consumer.
function %uext_iadd_two_uses(i32, i32) -> i64, i32 {
block0(v0: i32, v1: i32):
  v2 = iadd v0, v1
  v3 = uextend.i64 v2
  return v3, v2
}

; VCode:
; block0:
;   add w1, w0, w1
;   mov x0, x1
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   add w1, w0, w1
;   mov x0, x1
;   ret

;; The producer being in another block does not change it either - the register
;; still holds what that instruction wrote.
function %uext_iadd_across_blocks(i32, i32) -> i64 {
block0(v0: i32, v1: i32):
  v2 = iadd v0, v1
  jump block1

block1:
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   add w0, w0, w1
;   b label1
; block1:
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   add w0, w0, w1
; block1: ; offset 0x4
;   ret

;; A block parameter has no producing instruction to inspect, so the extension
;; is real work and must still be emitted.
function %uext_block_param(i32) -> i64 {
block0(v0: i32):
  v1 = uextend.i64 v0
  return v1
}

; VCode:
; block0:
;   mov w0, w0
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   mov w0, w0
;   ret

;; And an `$I8` producer leaves bits 31:8 holding the operation's own result,
;; which is exactly what this `uextend` has to clear. The W-form write says
;; nothing about them.
function %uext_iadd_i8(i8, i8) -> i64 {
block0(v0: i8, v1: i8):
  v2 = iadd v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   add w4, w0, w1
;   uxtb w0, w4
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   add w4, w0, w1
;   uxtb w0, w4
;   ret

