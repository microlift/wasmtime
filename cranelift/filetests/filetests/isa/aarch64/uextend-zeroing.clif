;   neg w3, w1
;   ror w0, w0, w3
;   ret

;; Negative cases: a `csel x` copies all 64 bits of an operand whose upper half
;; was never defined, so no amount of the comparison being in W form makes the
;; selection zeroing. These must keep emitting the extension.
function %uext_select(i32, i32, i32) -> i64 {
block0(v0: i32, v1: i32, v2: i32):
  v3 = select v0, v1, v2
  v4 = uextend.i64 v3
  return v4
}

; VCode:
; block0:
;   subs wzr, w0, wzr
;   csel x6, x1, x2, ne
;   mov w0, w6
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   cmp w0, wzr
;   csel x6, x1, x2, ne
;   mov w0, w6
;   ret

function %uext_smin(i32, i32) -> i64 {
block0(v0: i32, v1: i32):
  v2 = smin v0, v1
  v3 = uextend.i64 v2
  return v3
}

; VCode:
; block0:
;   subs wzr, w0, w1
;   csel x5, x0, x1, lt
;   mov w0, w5
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   cmp w0, w1
;   csel x5, x0, x1, lt
;   mov w0, w5
;   ret

